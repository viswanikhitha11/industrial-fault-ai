# Server
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/industrial-fault-ai

# Google Gemini API key — get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Vision-capable Gemini model to use for triage analysis
GEMINI_MODEL=gemini-3.8-flash

# The origin your Vite frontend runs on (must match frontend's dev server URL)
CLIENT_ORIGIN=http://localhost:5173
